# FlightScope AI — environment template. Copy to `.env` and fill in your keys.
# `.env` is gitignored; secrets never live in source code.

# --- External API credentials --------------------------------------------
AIRLABS_API_KEY=your-airlabs-key-here

# OpenSky (optional; anonymous works with low rate limits)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Amadeus (optional; self-service test key)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Eurostat and Google Trends require no API key.

# --- Data source / scheduler ---------------------------------------------
FLIGHTSCOPE_DATA_SOURCE=demo          # demo | live
FLIGHTSCOPE_SCHEDULER_AUTOSTART=0     # 1 to auto-start background sync jobs

# --- Sync intervals (seconds) --------------------------------------------
SYNC_INTERVAL_AIRPORT_METADATA=2592000   # monthly
SYNC_INTERVAL_SCHEDULES=86400            # daily
SYNC_INTERVAL_PRICES=86400               # daily
SYNC_INTERVAL_DEMAND=604800              # weekly

# Max departure airports crawled per supply sync (0 = all / "Global").
# A full crawl = 1 AirLabs request per airport (~967). The AirLabs FREE tier
# allows only ~1000 requests/MONTH, so leave this small on the free plan.
SYNC_MAX_AIRPORTS=30

# --- Database (optional; default is local SQLite) ------------------------
# FLIGHTSCOPE_DB_URL=postgresql+psycopg://user:pass@localhost:5432/flightscope
